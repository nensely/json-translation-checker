{
  "name": "json-translation-checker",
  "displayName": "json-translation-checker",
  "description": "Compares translation keys across JSON files and identifies missing translations.",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.140.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "jsonTranslationChecker.compare",
        "title": "Сравнить переводы JSON"
      },
      {
        "command": "jsonTranslationChecker.openSettings",
        "title": "Настройки проверки переводов JSON"
      }
    ],
    "configuration": {
      "title": "JSON Translation Checker",
      "type": "object",
      "properties": {
        "jsonTranslationChecker.checkEmptyTranslations": {
          "type": "boolean",
          "default": true,
          "order": 1,
          "description": "Проверять пустые строки и строки, состоящие только из пробелов."
        },
        "jsonTranslationChecker.checkValueTypes": {
          "type": "boolean",
          "default": true,
          "order": 2,
          "description": "Проверять совпадение типов значений между эталоном и переводом."
        },
        "jsonTranslationChecker.checkExtraKeys": {
          "type": "boolean",
          "default": true,
          "order": 3,
          "description": "Находить лишние ключи, которых нет в эталонном файле."
        },
        "jsonTranslationChecker.promptToSaveReport": {
          "type": "boolean",
          "default": true,
          "order": 4,
          "description": "Предлагать сохранить Markdown-отчёт после проверки."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.140.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "typescript-eslint": "^8.61.1",
    "eslint": "^10.5.0",
    "esbuild": "^0.28.1",
    "npm-run-all": "^4.1.5",
    "typescript": "^6.0.3",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}